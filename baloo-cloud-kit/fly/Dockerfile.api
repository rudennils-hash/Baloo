# Baloo API-service – Node.js
# OBS: Detta är endast en API-tjänstmall. Baloo-projektet har ingen färdig
# server-entrypoint än – ersätt "node dist/api.js" med rätt startkommando
# när API:et byggs.
FROM node:20-alpine

WORKDIR /app

# Krävs byggkontext = repots root (peka på rätt mapp för API:et)
COPY package*.json ./
RUN npm ci --omit=dev || true

COPY . .

EXPOSE 8080
CMD ["node", "dist/api.js"]